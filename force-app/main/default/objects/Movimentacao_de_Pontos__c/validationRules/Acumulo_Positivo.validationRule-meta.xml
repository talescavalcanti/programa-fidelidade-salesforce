<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Acumulo_Positivo</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(ISPICKVAL(Tipo__c, "Acúmulo"), Pontos_Base__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Pontos_Base__c</errorDisplayField>
    <errorMessage>Um acúmulo deve ter pontos base maiores que zero.</errorMessage>
</ValidationRule>
