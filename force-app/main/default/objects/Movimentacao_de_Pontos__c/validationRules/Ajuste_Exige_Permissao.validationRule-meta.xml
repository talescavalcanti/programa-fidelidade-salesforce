<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ajuste_Exige_Permissao</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(ISPICKVAL(Tipo__c, "Ajuste"), NOT($Permission.Ajustar_Pontos))</errorConditionFormula>
    <errorDisplayField>Tipo__c</errorDisplayField>
    <errorMessage>Apenas usuários com o conjunto de permissões Ajuste de Pontos podem registrar ajustes.</errorMessage>
</ValidationRule>
