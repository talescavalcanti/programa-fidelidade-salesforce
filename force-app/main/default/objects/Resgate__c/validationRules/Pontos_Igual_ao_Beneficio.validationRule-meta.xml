<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pontos_Igual_ao_Beneficio</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(ISNEW(), Pontos__c &lt;&gt; Beneficio__r.Pontos_Necessarios__c)</errorConditionFormula>
    <errorDisplayField>Pontos__c</errorDisplayField>
    <errorMessage>Os pontos do resgate devem ser iguais aos pontos necessários do benefício.</errorMessage>
</ValidationRule>
