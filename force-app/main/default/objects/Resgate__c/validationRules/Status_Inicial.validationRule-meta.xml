<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Inicial</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(ISNEW(), NOT(ISPICKVAL(Status__c, "Em Aprovação")))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Todo resgate nasce com o status Em Aprovação.</errorMessage>
</ValidationRule>
