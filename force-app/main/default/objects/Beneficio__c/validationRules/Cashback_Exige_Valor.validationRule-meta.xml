<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cashback_Exige_Valor</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Cashback", OR(ISBLANK(Valor_Cashback__c), Valor_Cashback__c &lt;= 0))</errorConditionFormula>
    <errorDisplayField>Valor_Cashback__c</errorDisplayField>
    <errorMessage>Informe o valor do cashback.</errorMessage>
</ValidationRule>
