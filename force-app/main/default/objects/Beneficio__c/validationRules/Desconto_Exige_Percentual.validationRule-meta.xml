<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Desconto_Exige_Percentual</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Desconto", OR(ISBLANK(Percentual_Desconto__c), Percentual_Desconto__c &lt;= 0, Percentual_Desconto__c &gt; 1))</errorConditionFormula>
    <errorDisplayField>Percentual_Desconto__c</errorDisplayField>
    <errorMessage>Informe um percentual de desconto entre 0 e 100.</errorMessage>
</ValidationRule>
