<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Screen Flow: mostra o saldo, lista os benefícios elegíveis, valida e cria o Resgate do participante.</description>
    <environments>Default</environments>
    <interviewLabel>SF Novo Resgate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SF Novo Resgate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <dynamicChoiceSets>
        <name>chBeneficios</name>
        <collectionReference>Obter_Beneficios</collectionReference>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Beneficio__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <decisions>
        <name>Saldo_Existe</name>
        <label>Saldo encontrado?</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Obter_Beneficios</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sim</defaultConnectorLabel>
        <rules>
            <name>Sem_Saldo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Obter_Saldo</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tela_Erro</targetReference>
            </connector>
            <label>Sem_Saldo</label>
        </rules>
    </decisions>
    <decisions>
        <name>Ha_Beneficios</name>
        <label>Há benefícios elegíveis?</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Tela_Escolha</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sim</defaultConnectorLabel>
        <rules>
            <name>Nenhum</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Obter_Beneficios</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tela_Sem_Beneficios</targetReference>
            </connector>
            <label>Nenhum</label>
        </rules>
    </decisions>
    <decisions>
        <name>Resgate_Valido</name>
        <label>Resgate válido?</label>
        <locationX>176</locationX>
        <locationY>900</locationY>
        <defaultConnector>
            <targetReference>Verificar_Limite</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sim</defaultConnectorLabel>
        <rules>
            <name>Invalido</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vValido</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tela_Erro</targetReference>
            </connector>
            <label>Invalido</label>
        </rules>
    </decisions>
    <formulas>
        <name>fAviso</name>
        <dataType>String</dataType>
        <expression>IF({!vExigeAprovacao}, "Este resgate ultrapassa o limite e exigirá aprovação do Coordenador e do Diretor.", "Este resgate será aprovado automaticamente.")</expression>
    </formulas>
    <recordCreates>
        <name>Criar_Resgate</name>
        <label>Criar Resgate</label>
        <locationX>176</locationX>
        <locationY>1300</locationY>
        <connector>
            <targetReference>Tela_Final</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Programa_Fidelidade__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Beneficio__c</field>
            <value>
                <elementReference>Escolha_Beneficio</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pontos__c</field>
            <value>
                <elementReference>Obter_Beneficio_Escolhido.Pontos_Necessarios__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Em Aprovação</stringValue>
            </value>
        </inputAssignments>
        <object>Resgate__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Obter_Saldo</name>
        <label>Obter Saldo</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Saldo_Existe</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Programa_Fidelidade__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Saldo_de_Pontos__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Obter_Beneficios</name>
        <label>Obter Benefícios Elegíveis</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Ha_Beneficios</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Ativo__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Pontos_Necessarios__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>Obter_Saldo.Saldo_Atual__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Beneficio__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Obter_Beneficio_Escolhido</name>
        <label>Obter Benefício Escolhido</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Validar_Resgate</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Escolha_Beneficio</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Beneficio__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Tela_Escolha</name>
        <label>Escolher benefício</label>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Obter_Beneficio_Escolhido</targetReference>
        </connector>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <fields>
            <name>Info_Saldo</name>
            <fieldText>Saldo atual: {!Obter_Saldo.Saldo_Atual__c} pontos | Categoria: {!Obter_Saldo.Categoria_Atual__c}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Escolha_Beneficio</name>
            <choiceReferences>chBeneficios</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Benefício</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Confirmacao</name>
        <label>Confirmar resgate</label>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Criar_Resgate</targetReference>
        </connector>
        <locationX>176</locationX>
        <locationY>1100</locationY>
        <fields>
            <name>Resumo</name>
            <fieldText>Benefício: {!Obter_Beneficio_Escolhido.Name} | Pontos: {!Obter_Beneficio_Escolhido.Pontos_Necessarios__c}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Aviso</name>
            <fieldText>{!fAviso}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Final</name>
        <label>Resgate registrado</label>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <locationX>176</locationX>
        <locationY>1450</locationY>
        <fields>
            <name>Final</name>
            <fieldText>Resgate {!Criar_Resgate.Name} registrado com sucesso. Status inicial: Em Aprovação (o fluxo automático ou o processo de aprovação define o resultado).</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Sem_Beneficios</name>
        <label>Sem benefícios disponíveis</label>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <locationX>500</locationX>
        <locationY>500</locationY>
        <fields>
            <name>SemBen</name>
            <fieldText>Nenhum benefício ativo cabe no saldo atual deste participante.</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Erro</name>
        <label>Não foi possível continuar</label>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <locationX>500</locationX>
        <locationY>900</locationY>
        <fields>
            <name>Erro</name>
            <fieldText>{!vMensagem}{!$Flow.FaultMessage}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <subflows>
        <name>Validar_Resgate</name>
        <label>Validar Resgate</label>
        <locationX>176</locationX>
        <locationY>800</locationY>
        <connector>
            <targetReference>Resgate_Valido</targetReference>
        </connector>
        <flowName>Sub_Validar_Resgate</flowName>
        <inputAssignments>
            <name>varSaldo</name>
            <value>
                <elementReference>Obter_Saldo.Saldo_Atual__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPontos</name>
            <value>
                <elementReference>Obter_Beneficio_Escolhido.Pontos_Necessarios__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varBeneficioAtivo</name>
            <value>
                <elementReference>Obter_Beneficio_Escolhido.Ativo__c</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>vValido</assignToReference>
            <name>varValido</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>vMensagem</assignToReference>
            <name>varMensagem</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Verificar_Limite</name>
        <label>Verificar Limite de Aprovação</label>
        <locationX>176</locationX>
        <locationY>1000</locationY>
        <connector>
            <targetReference>Tela_Confirmacao</targetReference>
        </connector>
        <flowName>Sub_Verificar_Limite</flowName>
        <inputAssignments>
            <name>varPontos</name>
            <value>
                <elementReference>Obter_Beneficio_Escolhido.Pontos_Necessarios__c</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>vExigeAprovacao</assignToReference>
            <name>varExigeAprovacao</name>
        </outputAssignments>
    </subflows>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obter_Saldo</targetReference>
        </connector>
    </start>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vValido</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vMensagem</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vExigeAprovacao</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <status>Active</status>
</Flow>
