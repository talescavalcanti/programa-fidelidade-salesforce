<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Subflow: informa se um resgate com a quantidade de pontos recebida exige aprovação (limite de 1.000 pontos).</description>
    <environments>Default</environments>
    <interviewLabel>Sub - Verificar Limite de Aprovação {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub - Verificar Limite de Aprovação</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <constants>
        <name>cLimiteAprovacao</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>1000.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Acima_do_Limite</name>
        <label>Acima do limite?</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Nao_Exige</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPontos</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>cLimiteAprovacao</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Exige</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <assignments>
        <name>Exige</name>
        <label>Exige aprovação</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>varExigeAprovacao</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Nao_Exige</name>
        <label>Não exige aprovação</label>
        <locationX>300</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>varExigeAprovacao</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Acima_do_Limite</targetReference>
        </connector>
    </start>
    <variables>
        <name>varPontos</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varExigeAprovacao</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <status>Active</status>
</Flow>
