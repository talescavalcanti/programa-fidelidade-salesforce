<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Após criar um Resgate, chama o subflow de limite: acima do limite envia ao processo de aprovação; abaixo, aprova automaticamente.</description>
    <environments>Default</environments>
    <interviewLabel>RT Resgate - Direcionar Aprovação {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT Resgate - Direcionar Aprovação</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Enviar_para_Aprovacao</name>
        <label>Enviar para Aprovação</label>
        <locationX>50</locationX>
        <locationY>650</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Aprovacao_de_Resgate</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skipEntryCriteria</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
    </actionCalls>
    <decisions>
        <name>Exige_Aprovacao</name>
        <label>Exige aprovação?</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <defaultConnector>
            <targetReference>Aprovar_Automaticamente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vExigeAprovacao</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Marcar_Exige_Aprovacao</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Marcar_Exige_Aprovacao</name>
        <label>Marcar Exige Aprovação</label>
        <locationX>50</locationX>
        <locationY>550</locationY>
        <connector>
            <targetReference>Enviar_para_Aprovacao</targetReference>
        </connector>
        <inputAssignments>
            <field>Exige_Aprovacao__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Aprovar_Automaticamente</name>
        <label>Aprovar Automaticamente</label>
        <locationX>300</locationX>
        <locationY>550</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Aprovado</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <subflows>
        <name>Verificar_Limite</name>
        <label>Verificar Limite</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <connector>
            <targetReference>Exige_Aprovacao</targetReference>
        </connector>
        <flowName>Sub_Verificar_Limite</flowName>
        <inputAssignments>
            <name>varPontos</name>
            <value>
                <elementReference>$Record.Pontos__c</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>vExigeAprovacao</assignToReference>
            <name>varExigeAprovacao</name>
        </outputAssignments>
    </subflows>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Resgate__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Verificar_Limite</targetReference>
        </connector>
    </start>
    <variables>
        <name>vExigeAprovacao</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <status>Active</status>
</Flow>
