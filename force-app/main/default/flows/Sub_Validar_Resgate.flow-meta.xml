<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Subflow: valida se o benefício está ativo e se o saldo cobre os pontos do resgate.</description>
    <environments>Default</environments>
    <interviewLabel>Sub - Validar Resgate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub - Validar Resgate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Beneficio_Ativo</name>
        <label>Benefício ativo?</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Saldo_Suficiente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ativo</defaultConnectorLabel>
        <rules>
            <name>Inativo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBeneficioAtivo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Msg_Inativo</targetReference>
            </connector>
            <label>Inativo</label>
        </rules>
    </decisions>
    <decisions>
        <name>Saldo_Suficiente</name>
        <label>Saldo suficiente?</label>
        <locationX>300</locationX>
        <locationY>400</locationY>
        <defaultConnector>
            <targetReference>Msg_Ok</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Suficiente</defaultConnectorLabel>
        <rules>
            <name>Insuficiente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPontos</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varSaldo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Msg_Insuficiente</targetReference>
            </connector>
            <label>Insuficiente</label>
        </rules>
    </decisions>
    <assignments>
        <name>Msg_Inativo</name>
        <label>Mensagem: inativo</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>varValido</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensagem</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Este benefício está inativo.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Msg_Insuficiente</name>
        <label>Mensagem: saldo insuficiente</label>
        <locationX>300</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varValido</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensagem</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Saldo de pontos insuficiente para este benefício.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Msg_Ok</name>
        <label>Mensagem: válido</label>
        <locationX>500</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>varValido</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensagem</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Resgate válido.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Beneficio_Ativo</targetReference>
        </connector>
    </start>
    <variables>
        <name>varSaldo</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varPontos</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varBeneficioAtivo</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varValido</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varMensagem</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <status>Active</status>
</Flow>
